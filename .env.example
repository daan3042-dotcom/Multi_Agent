# Template voor .env op de VPS (roadmap 1.11). Kopieer naar `.env` naast
# run_daily.sh/run_daily.py en vul echte waarden in -- .env staat in
# .gitignore, commit 'm dus nooit.

# monetary_policy + financial + economic agent
FRED_API_KEY=

# currency + sector + commodity agent
ALPHAVANTAGE_API_KEY=

# alleen nodig bij --deep-dives
ANTHROPIC_API_KEY=

# pad naar de SQLite-database (default: ./market_intelligence.db in de
# working directory van run_daily.py -- expliciet zetten voorkomt dat een
# cron-cwd-verrassing de database op een onverwachte plek aanmaakt)
MI_DB_PATH=/opt/multi_agent/market_intelligence.db

# zonder deze URL gaat een melding ALLEEN naar de log -- zie
# src/runtime/notifications.py::webhook_notifier. ntfy.sh/Telegram/Discord
# werken allemaal (generieke JSON POST).
MI_WEBHOOK_URL=

# Cohort voor NIEUWE voorspellingen: dry_run (default als dit leeg is),
# pseudo_oos of cohort_0.
#
# LAAT DIT LEEG tot T₀ᵇ. Alles wat vóór de freeze wordt voorspeld hoort niet
# in het echte cohort, en een verkeerd label is niet te herstellen (de
# predictions-tabel heeft geen update-pad). Zet op T₀ᵇ, NA de freeze:
#     MI_COHORT=cohort_0
# en controleer daarna: sqlite3 $MI_DB_PATH "SELECT cohort, COUNT(*) FROM predictions GROUP BY cohort;"
# Een typefout (bijv. cohort0) laat run_daily.py met exit 2 stoppen.
MI_COHORT=
